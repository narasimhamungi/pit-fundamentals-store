LOG_LEVEL=INFO
LOG_FILE=logs/pit_fundamentals_store.log
SEC_USER_AGENT=pit-fundamentals-store YourName your.email@example.com
SEC_REQUEST_DELAY_SECONDS=0.25
SEC_TIMEOUT_SECONDS=30
POSTGRES_HOST=localhost
# 5433, not 5432 — avoids colliding with marketdata-lakehouse's own
# docker-compose postgres container, which maps host 5432.
POSTGRES_PORT=5433
POSTGRES_DB=pit_fundamentals
POSTGRES_USER=pit_user
POSTGRES_PASSWORD=pit_password
HISTORICAL_START_YEAR=2010
HISTORICAL_END_YEAR=2026
SAMPLE_CIKS=320193
# Alternative to SAMPLE_CIKS: comma-separated tickers, resolved to CIKs at
# runtime via SEC's company_tickers.json (see universe.py). Takes precedence
# over SAMPLE_CIKS when set. Current-ticker-map only — not dated index
# membership; see universe.py's module docstring.
TICKERS=
# Only needed for non-editable installs (e.g. Docker) where sql/ isn't
# resolvable relative to the installed package. Local `pip install -e .`
# dev setups can leave this unset.
SCHEMA_PATH=